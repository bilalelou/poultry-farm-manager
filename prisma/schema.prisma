generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                      Int      @id @default(autoincrement())
  incubatorCapacity       Int      @default(100)
  feedPrices              Json     // { starter, grower, preLayer, layer }
  dailyFeedConsumption    Json     // { starter, grower, preLayer, layer }
  sellingPrices           Json     // { egg, tray, fertilizedEgg, chick, culledHen, maleBroiler, manure }
  marketReadyHenPrice     Float    @default(75)
  targetRates             Json     // { fertility, hatch, production, maxMortality }
  housingDensity          Float    @default(6)
  incubatorElectricityCost Float   @default(60)
  incubatorCleaningCost   Float    @default(20)
  currency                String   @default("MAD")
  currencySymbol          String   @default("د.م")
  updatedAt               DateTime @updatedAt
}

model IncubatorBatch {
  id                   Int      @id @default(autoincrement())
  batchCode            String   @unique
  startDate            String
  eggCount             Int
  eggSource            String   // internal | external
  eggCost              Float
  fertilizedCount      Int?
  fertilityRate        Float?
  hatchedChicks        Int?
  spoiledEggs          Int?
  hatchRate            Float?
  electricityCost      Float    @default(60)
  cleaningCost         Float    @default(20)
  totalCost            Float?
  costPerChick         Float?
  status               String   @default("incubating") // incubating | hatched | transferred
  linkedRearingBatchId Int?
  notes                String?
  createdAt            DateTime @default(now())
}

model RearingBatch {
  id                  Int                 @id @default(autoincrement())
  batchCode           String              @unique
  incubatorBatchId    Int?
  startDate           String
  initialChickCount   Int
  initialCostPerChick Float
  currentHealthyCount Int?
  mortalityCount      Int?                @default(0)
  malesCount          Int?                @default(0)
  currentAgeWeeks          Int?                @default(1)
  ageReferenceDate         String?
  status                   String              @default("rearing") // rearing | completed | transferred
  autoTransferToProduction Boolean             @default(true)
  notes                    String?
  createdAt           DateTime            @default(now())
  weeklyLogs          RearingWeeklyLog[]
}

model RearingWeeklyLog {
  id                      Int          @id @default(autoincrement())
  rearingBatchId          Int
  rearingBatch            RearingBatch @relation(fields: [rearingBatchId], references: [id], onDelete: Cascade)
  weekNumber              Int
  feedPhase               String       // starter | grower | preLayer
  remainingCount          Int
  weeklyMortality         Int          @default(0)
  cumulativeMortalityRate Float        @default(0)
  feedConsumed            Float        @default(0)
  feedCost                Float        @default(0)
  heatingCost             Float        @default(0)
  lightingCost            Float        @default(0)
  beddingCost             Float        @default(0)
  vaccinationCost         Float        @default(0)
  medicineCost            Float        @default(0)
  otherCosts              Float        @default(0)
  totalWeeklyCost         Float        @default(0)
  malesSold               Int          @default(0)
  malesSaleValue          Float        @default(0)
  notes                   String?
}

model DailyProduction {
  id                 Int      @id @default(autoincrement())
  date               String   @unique
  activeHenCount     Int
  dailyMortality     Int      @default(0)
  totalEggsCollected Int
  brokenEggs         Int      @default(0)
  incubatorEggs      Int      @default(0)
  personalUse        Int      @default(0)
  netSaleableEggs    Int
  productionRate     Float
  notes              String?
}

model Sale {
  id            Int      @id @default(autoincrement())
  date          String
  type          String   // eggs | fertilizedEggs | chicks | culledHens | manure | males
  quantity      Float
  unitType      String   // unit | tray
  unitPrice     Float
  total         Float
  buyerName     String?
  customerId    Int?
  paidAmount    Float?
  paymentStatus String   @default("paid") // paid | partial | unpaid
  notes         String?
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DebtPayment {
  id            Int      @id @default(autoincrement())
  date          String
  customerId    Int?
  customerName  String
  saleId        Int?
  amount        Float
  paymentMethod String   @default("cash") // cash | bank | check
  notes         String?
  createdAt     DateTime @default(now())
}

// === الديون التي على المزرعة (الالتزامات) ===
model PayableDebt {
  id           Int      @id @default(autoincrement())
  date         String
  creditorName String
  phone        String?
  category     String   @default("feed") // feed | equipment | chicks | medicine | loan | rent | other
  description  String
  totalAmount  Float
  paidAmount   Float    @default(0)
  dueDate      String?
  status       String   @default("unpaid") // unpaid | partial | paid
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PayablePayment {
  id            Int      @id @default(autoincrement())
  debtId        Int
  date          String
  amount        Float
  paymentMethod String   @default("cash") // cash | bank | check
  notes         String?
  createdAt     DateTime @default(now())
}

// === مخزون وحركات العلف ===
model FeedMovement {
  id           Int      @id @default(autoincrement())
  date         String
  movementType String   // purchase | consumption | adjustment
  feedType     String   @default("layer") // starter | grower | preLayer | layer
  quantityKg   Float
  cost         Float    @default(0)
  expenseId    Int?
  notes        String?
  createdAt    DateTime @default(now())
}

// === سجل أخطاء النظام والتتبع ===
model SystemLog {
  id        Int      @id @default(autoincrement())
  timestamp String
  level     String   @default("error") // error | warn | info
  source    String   // client | api | ui | db
  page      String?
  message   String
  details   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// === تاريخ تحركات القطيع ===
model FlockMovement {
  id           Int      @id @default(autoincrement())
  date         String
  flockGroupId Int?
  flockName    String
  movementType String   // transfer | addition | mortality | sale | culling
  fromLocation String?
  toLocation   String?
  malesCount   Int      @default(0)
  femalesCount Int      @default(0)
  totalCount   Int
  reason       String?
  notes        String?
  createdAt    DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        String
  scope       String   // general | batch | foundation
  batchId     Int?
  batchType   String?  // incubator | rearing
  type        String   // operational | capital
  category    String   // feed | medicine | electricity ...
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  total       Float
  notes       String?
}

model ExpansionPlan {
  id                  Int                  @id @default(autoincrement())
  name                String
  durationMonths      Int                  @default(12)
  targetMonthlyProfit Float                @default(5000)
  strategy            String               @default("incubator") // incubator | hybrid | purchased
  description         String?
  startDate           String
  createdAt           DateTime             @default(now())
  months              ExpansionPlanMonth[]
}

model ExpansionPlanMonth {
  id                    Int           @id @default(autoincrement())
  planId                Int
  plan                  ExpansionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  month                 Int
  addedHens             Int           @default(0)
  incubatorEggsUsed     Int           @default(0)
  source                String        // incubator | purchased
  estimatedMortality    Int           @default(0)
  netActiveHens         Int
  requiredSpaceM2       Float
  monthlyFeedKg         Float
  feedCost              Float
  rearingCost           Float         @default(0)
  expectedEggProduction Int
  maleSalesRevenue      Float         @default(0)
  expectedRevenue       Float
  operationalCost       Float
  expectedProfit        Float
  cumulativeProfit      Float
  selfFinancingGap      Float
  milestoneNote         String?
}

model Alert {
  id             Int      @id @default(autoincrement())
  date           String
  type           String   // info | warning | danger | success
  category       String   // incubator | vaccination | production | mortality | general
  title          String
  message        String
  relatedBatchId Int?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model FlockGroup {
  id          Int      @id @default(autoincrement())
  name        String   // اسم المجموعة / الحظيرة، مثلا: القطيع البياض الرئيسي، حظيرة الديوك، كتاكيت التربية
  category    String   // layers (بياض) | roosters (ديوك) | pullets (عتوكة) | chicks (كتاكيت) | broilers (تسمين)
  breed       String   @default("بلدي / خليط") // السلالة
  headCount   Int      // العدد الحالي
  malesCount  Int      @default(0) // عدد الذكور
  femalesCount Int     @default(0) // عدد الإناث
  ageWeeks    Int      @default(20) // العمر بالأسابيع
  ageReferenceDate String?
  housing     String?  // رقم أو اسم العنبر / الحظيرة
  healthStatus String  @default("ممتازة") // ممتازة، جيدة، تحت العلاج
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Investor {
  id               Int      @id @default(autoincrement())
  name             String   // اسم المستثمر / الشريك
  phone            String?  // رقم الهاتف
  email            String?  // البريد
  investedAmount   Float    // المبلغ المستثمر (د.م)
  ownershipShare   Float    // نسبة الحصة في المشروع (%)
  entryDate        String   // تاريخ الدخول / الاستثمار
  totalDistributed Float    @default(0) // إجمالي الأرباح الموزعة عليه حتى الآن
  status           String   @default("active") // active | exited
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ValuationItem {
  id          Int      @id @default(autoincrement())
  category    String   // equipment (معدات والآت) | livestock (ثروة حيوانية) | realestate (أراضي وبناء) | cash (سيولة) | other
  name        String   // اسم الأصل (مثلاً: فقاسة أوتوماتيكية، قطيع البياض، حظائر...)
  quantity    Float    @default(1)
  unitValue   Float    // القيمة التقديرية للوحدة
  totalValue  Float    // إجمالي القيمة
  notes       String?
  updatedAt   DateTime @updatedAt
}

// === تسيير التعاونية الفلاحية ===
model CooperativeProfile {
  id               Int      @id @default(autoincrement())
  name             String   @default("تعاونية مراعي الوادي")
  registrationNo   String?
  foundedDate      String?
  headquarters     String?  @default("دوار الخرابشة الأندلس، عين الشقف، مولاي يعقوب، فاس")
  activity         String   @default("تربية الدواجن، تربية المواشي، إنتاج الأعلاف البديلة وتثمينها، وتسويق المنتوجات الفلاحية")
  bankRib          String?
  shareUnitValue   Float    @default(100)
  legalReserveRate Float    @default(10)
  notes            String?
  updatedAt        DateTime @updatedAt
}

model CooperativeMember {
  id          Int      @id @default(autoincrement())
  fullName    String
  cin         String?
  phone       String?
  role        String   @default("member") // president | vice_president | treasurer | secretary | member
  joinDate    String
  sharesCount Int      @default(1)
  paidCapital Float    @default(0)
  status      String   @default("active") // active | suspended | exited
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CooperativeTransaction {
  id            Int      @id @default(autoincrement())
  date          String
  type          String   // contribution | grant | coop_sale | coop_expense | admin_expense | profit_distribution
  category      String   @default("other") // shares | feed | equipment | eggs | subsidy | admin | other
  memberId      Int?
  memberName    String?
  amount        Float
  paymentMethod String   @default("cash") // cash | bank | check
  referenceNo   String?
  description   String
  notes         String?
  createdAt     DateTime @default(now())
}

model CooperativeMeeting {
  id             Int      @id @default(autoincrement())
  date           String
  title          String
  type           String   @default("board_meeting") // general_ordinary | general_extraordinary | board_meeting
  attendeesCount Int      @default(0)
  agenda         String
  decisions      String?
  status         String   @default("completed") // scheduled | completed
  notes          String?
  createdAt      DateTime @default(now())
}
